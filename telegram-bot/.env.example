# From @BotFather — never commit the real token.
# Copy this file to .env and put the real value there. .env is gitignored.
TELEGRAM_BOT_TOKEN=

# Where the backend API is reachable.
API_BASE_URL=http://localhost:4000

# Must match ADMIN_TOKEN in backend/.env if the backend has one set.
ADMIN_TOKEN=

# Comma-separated Telegram chat IDs allowed to run /heal, /approve and /refresh.
# Send /heal to the bot from your account to see your own chat ID.
TELEGRAM_ADMIN_CHAT_IDS=
