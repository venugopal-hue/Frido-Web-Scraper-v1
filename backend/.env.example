# ---- Bright Data ----
# Collector ID returned by `bdata scraper create` (products scraper).
COLLECTOR_ID=c_mt11rkfr1irkjzsb9
# Collector ID for the category-index scraper (optional).
CATEGORIES_COLLECTOR_ID=
# Collector ID for the product-page multi-pack pricing scraper.
PACKS_COLLECTOR_ID=c_mt15pipw2hu94v7ehy

# Path to a `bdata` binary on PATH. Leave unset to invoke via npx.
# BDATA_CLI=bdata

# The CLI reads credentials from `bdata login`. If you prefer an explicit key,
# export BRIGHTDATA_API_KEY instead — never commit the real value.
# BRIGHTDATA_API_KEY=

# ---- API ----
PORT=4000
DB_PATH=../data/scrapeverse.db
# Shared secret for the endpoints that spend credits (/api/refresh, /api/heal).
# Leave blank in local dev to disable the check.
ADMIN_TOKEN=

# ---- Scheduler ----
ENABLE_SCHEDULER=false
CRON_SCHEDULE=0 */6 * * *
# Cap how many collection pages a single run touches (keeps demo runs cheap).
# Leave blank to scrape every discovered collection.
MAX_CATEGORIES=

# How many collection URLs go into one `bdata scraper run --urls` call.
# Large batches are silently capped (31 URLs at once returned ~5 products each
# instead of the full grid), so keep this small.
SCRAPE_CHUNK_SIZE=4

# ---- Image backfill ----
# The collection grid lazy-loads images, so most rows arrive without one. The
# pipeline refills them from /products/{handle}.json. Set ENRICH=false to skip.
ENRICH=true
ENRICH_CONCURRENCY=5

# ---- Telegram ----
# From @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to run /heal from chat.
TELEGRAM_ADMIN_CHAT_IDS=
API_BASE_URL=http://localhost:4000
